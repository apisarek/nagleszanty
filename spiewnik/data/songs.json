            { "text": "Pal! 💥 PAL! i we wroga", "chords": ["D"] },
            { "text": "", "chords": ["e"] }
          ]
        },
        {
          "label": "2.",
          "lines": [
            { "text": "Kanonier nasz tak jak jego tata", "chords": ["e", "e", "D", "e"] },
            { "text": "Walczy dla króla czy to noc czy dzień", "chords": ["C", "C", "D", "e"] },
            { "text": "Siostrą mu jest, żelazna armata", "chords": ["e", "e", "D", "e"] },
            { "text": "Matkę spotyka, jedynie przez sen", "chords": ["C", "C", "D", "e"] },
            { "text": "Długa rozłąka spaja ludzi morza,", "chords": [] },
            { "text": "mijają lata wśród błękitu fal.", "chords": [] },
            { "text": "I przeznaczeniem walka o przestworza", "chords": [] }
          ]
        },
