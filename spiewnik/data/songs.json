      "sections": [
        {
          "label": "1.",
          "lines": [
            { "text": "Opowiem wam historię kanoniera", "chords": ["e", "e", "D", "e"] },
            { "text": "Na galeonie spędził żywot swój", "chords": ["C", "C", "D", "e"] },
            { "text": "Nieważne czy pogoda mu doskwiera", "chords": ["e", "e", "D", "e"] },
            { "text": "Poddany króla godnie rusza w bój", "chords": ["C", "C", "D", "e"] },
            { "text": "Trze prochy w pył, węgiel oraz siarkę.", "chords": ["e", "e", "D", "e"] },
            { "text": "Saletry też mu nie będzie żal.", "chords": ["C", "C", "D", "e"] },
            { "text": "Sypie do lufy by rozpocząć walkę.", "chords": ["e", "e", "D", "e"] }
          ]
        },
        {
          "label": "Ref.",
          "lines": [
            { "text": "A ty", "chords": ["C"] },
            { "text": "Ładuj kule", "chords": ["D"] },
            { "text": "Pal! 💥 PAL! zetrzyj prochy", "chords": ["e"] },
            { "text": "Pal! 💥 PAL! syp do lufy", "chords": ["C"] },
            { "text": "Pal! 💥 PAL! i we wroga", "chords": ["D"] },
            { "text": "Wal! 💥", "chords": ["e"] },
            { "text": "Ładuj kule", "chords": ["e", "D"] },
            { "text": "Pal! 💥 PAL! zetrzyj prochy", "chords": ["e"] },
