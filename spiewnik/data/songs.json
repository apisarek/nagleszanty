        {
          "label": "3.",
          "lines": [
            { "text": "Bohater pieśni ma stopień sierżanta", "chords": ["e", "e", "D", "e"] },
            { "text": "Jego atutem jest sokoli wzrok", "chords": ["C", "C", "D", "e"] },
            { "text": "Nieważny cel - czy to maszt czy wanta", "chords": ["e", "e", "D", "e"] },
            { "text": "Bez zawahania trafia w rei nok", "chords": ["C", "C", "D", "e"] },
            { "text": "Kula z łańcuchem, ognista albo kartacz,", "chords": [] },
            { "text": "dziurawi wrogom floty każdy cal.", "chords": [] },
            { "text": "Lecz ich modlitwa jest niewiele warta", "chords": [] }
